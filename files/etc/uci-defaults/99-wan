#!/bin/sh
# First-boot: unbind lan1 from br-lan, bind WAN to lan1 (instead of pon0).
# Use network restart + wan ifup so DHCP works without a full device reboot.

. /lib/functions.sh

# --- 1) Remove lan1 from every bridge that lists it (normally br-lan) ---
remove_lan1_from_bridges() {
	local section="$1"
	local type ports p new

	config_get type "$section" type
	[ "$type" = "bridge" ] || return 0

	config_get ports "$section" ports
	[ -n "$ports" ] || return 0

	new=
	for p in $ports; do
		[ "$p" = "lan1" ] && continue
		new="${new:+$new }$p"
	done

	if [ "$new" != "$ports" ]; then
		uci -q delete "network.$section.ports"
		for p in $new; do
			uci -q add_list "network.$section.ports=$p"
		done
	fi
}

config_load network
config_foreach remove_lan1_from_bridges device

# --- 2) Point WAN / WAN6 at lan1 ---
if uci -q get network.wan >/dev/null 2>&1; then
	uci -q set network.wan.device='lan1'
else
	uci -q batch <<EOF
set network.wan=interface
set network.wan.proto='dhcp'
set network.wan.device='lan1'
EOF
fi

if uci -q get network.wan6 >/dev/null 2>&1; then
	uci -q set network.wan6.device='lan1'
fi

uci -q commit network

# Bridge port moves need a full network restart; reload is often not enough.
sleep 2
/etc/init.d/network restart 2>/dev/null || true

# Give netifd a moment, then force WAN to renew DHCP on lan1.
sleep 3
ifdown wan 2>/dev/null || true
ifdown wan6 2>/dev/null || true
sleep 1
ifup wan 2>/dev/null || true
ifup wan6 2>/dev/null || true

exit 0
