#!/bin/sh
# First-boot: unbind lan1 from br-lan, bind WAN to lan1 (instead of pon0).

. /lib/functions.sh

# --- 1) Remove lan1 from every bridge that lists it (normally br-lan) ---
remove_lan1_from_bridges() {
	local section="$1"
	local type ports p new

	config_get type "$section" type
	[ "$type" = "bridge" ] || return 0

	config_get ports "$section" ports
	[ -n "$ports" ] || return 0

	new=
	for p in $ports; do
		[ "$p" = "lan1" ] && continue
		new="${new:+$new }$p"
	done

	# Only rewrite when lan1 was actually present
	if [ "$new" != "$ports" ]; then
		if [ -n "$new" ]; then
			uci -q delete "network.$section.ports"
			for p in $new; do
				uci -q add_list "network.$section.ports=$p"
			done
		else
			uci -q delete "network.$section.ports"
		fi
	fi
}

config_load network
config_foreach remove_lan1_from_bridges device

# --- 2) Point WAN at lan1 (replace pon0 / any previous device) ---
# Prefer the logical interface named "wan"; fall back to first interface with proto dhcp/pppoe if needed.
if uci -q get network.wan >/dev/null 2>&1; then
	uci -q set network.wan.device='lan1'
else
	# No section named wan: create a minimal DHCP WAN on lan1
	uci -q batch <<EOF
set network.wan=interface
set network.wan.proto='dhcp'
set network.wan.device='lan1'
EOF
fi

# If there is a separate wan6, keep it on the same L2 device
if uci -q get network.wan6 >/dev/null 2>&1; then
	uci -q set network.wan6.device='lan1'
fi

uci -q commit network

# Apply once if network is already up (safe on first boot too)
/etc/init.d/network reload 2>/dev/null || true

exit 0
