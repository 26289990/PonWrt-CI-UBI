#!/bin/sh
DIR=/etc/uci-defaults/prebuilt-apks
LOG=/tmp/prebuilt-apks.log

sleep 20

echo "start $(date)" > "$LOG"

if [ ! -d "$DIR" ]; then
	echo "missing $DIR" >> "$LOG"
	logger -t prebuilt-apks "missing $DIR"
	exit 0
fi

ls -la "$DIR" >> "$LOG" 2>&1

count=0
fail=0
for f in "$DIR"/*.apk; do
	[ -f "$f" ] || continue
	count=$((count + 1))
	echo "INSTALL $f" >> "$LOG"
	if /usr/bin/apk add --allow-untrusted --force-overwrite "$f" >> "$LOG" 2>&1; then
		logger -t prebuilt-apks "OK $(basename "$f")"
	else
		fail=$((fail + 1))
		logger -t prebuilt-apks "FAIL $(basename "$f")"
	fi
done

echo "count=$count fail=$fail" >> "$LOG"
logger -t prebuilt-apks "count=$count fail=$fail"

# 成功才删；失败保留 apk 和 log
if [ "$count" -gt 0 ] && [ "$fail" -eq 0 ]; then
	rm -rf "$DIR"
	echo "removed $DIR" >> "$LOG"
else
	echo "keep $DIR" >> "$LOG"
fi

exit 0
